# Database
DATABASE_URL="postgresql://storyuser:CHANGE_ME_DB_PASS@db:5432/storychain?schema=public"

# Redis
REDIS_URL="redis://redis:6379"

# NextAuth
NEXTAUTH_URL="https://storychain.com.tr"
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_SECRET"

# Argon2 Configuration
ARGON2_MEMORY=512
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# PIN Configuration
PIN_MIN=4
PIN_MAX=6

# App Configuration
APP_NAME="StoryChain"

# Rate Limiting
RATE_LIMIT_WINDOW=10
RATE_LIMIT_MAX=3

# Domain Configuration
DOMAIN="storychain.com.tr"
WWW_DOMAIN="www.storychain.com.tr"

# Caddy Configuration
CADDY_DISABLE_LOGS=false
